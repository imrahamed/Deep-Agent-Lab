# Start with live mode. Use DEEP_LAB_MODE=demo for the offline fixtures.
DEEP_LAB_MODE=live
# Reuse the PostgreSQL, OpenSearch, Ollama embedding, and Langfuse configuration.
# RAG_LAB_ENV_FILE=C:/path/to/Rag-project/.env
# Or specify your own service settings here.
# POSTGRES_DSN=postgresql://user:password@server:5432/database?sslmode=verify-full
# OPENSEARCH_URL=https://search.example.com:9200
# OPENSEARCH_USERNAME=course_user
# OPENSEARCH_PASSWORD=
# OPENSEARCH_CA_CERT=C:/certificates/opensearch-ca.pem
OPENSEARCH_INDEX=deep-agent-lab-v1
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:latest
OLLAMA_CONTEXT_TOKENS=16384
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
DEEP_LAB_STATE_DIR=.deep-lab

# Omit these settings to inherit credentials and endpoint from RAG_LAB_ENV_FILE.
# LANGFUSE_ENABLED=true
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
