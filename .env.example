# Course labs use real models and services. Configure prerequisites before running.
DEEP_LAB_MODE=live
LANGFUSE_ENABLED=false
# Configure this repository's service endpoints and credentials here.
# POSTGRES_DSN=postgresql://user:password@server:5432/database?sslmode=verify-full
# OPENSEARCH_URL=https://search.example.com:9200
# OPENSEARCH_USERNAME=course_user
# OPENSEARCH_PASSWORD=
# OPENSEARCH_CA_CERT=C:/certificates/opensearch-ca.pem
OPENSEARCH_INDEX=deep-agent-lab-v1
# OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3.5:latest
OLLAMA_CONTEXT_TOKENS=16384
# OLLAMA_EMBED_MODEL=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
DEEP_LAB_STATE_DIR=.deep-lab

# Optional tracing credentials. Set LANGFUSE_ENABLED=true to enable export.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CAPTURE_CONTENT=false
